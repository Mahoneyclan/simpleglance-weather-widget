<?xml version="1.0"?>
<resources>
    <properties>
        <property id="refresh_rate" type="number">30</property>
        <!-- Default Home: Brisbane CBD (owner decision 2026-10-31). Blank = Home
             not set (Home mirrors GPS). Versions before 1.5.0 shipped other
             coordinates here; HomeSettings treats those values as "not set".
             A default only applies to new installs; existing ones keep their values.
             The same values are in HomeSettings.DEFAULT_LAT/LON. -->
        <property id="home_lat"     type="string">-27.4698</property>
        <property id="home_lon"     type="string">153.0251</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.refresh_rate" title="@Strings.SettingRefresh">
            <settingConfig type="list">
                <listEntry value="15">15 minutes</listEntry>
                <listEntry value="30">30 minutes</listEntry>
                <listEntry value="60">1 hour</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.home_lat" title="@Strings.SettingHomeLat">
            <settingConfig type="alphaNumeric" maxLength="12"/>
        </setting>
        <setting propertyKey="@Properties.home_lon" title="@Strings.SettingHomeLon">
            <settingConfig type="alphaNumeric" maxLength="12"/>
        </setting>
    </settings>
</resources>
